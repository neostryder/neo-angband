{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* A second project rather than a wider "include" on tsconfig.json: web's
     * own config sets rootDir src, and the demo mods are not part of the
     * shipped web build. The file lives BESIDE mods/, not in it, because the
     * bundled-mod tests (mod-hooks, tile-catalog, pack-status) enumerate every
     * entry under mods/ as a mod directory. */
    "rootDir": "mods",
    /* Vite/esbuild bundle these sources (import.meta.glob over mods/<id>/);
     * tsc is here only to type-check the bundled demo mods, the way a real
     * external mod repo's tsconfig would. Declarations still emit so this can
     * be a composite project and take part in `tsc -b`, which is what keeps
     * mods/ inside the same gate as the packages. dist-types is gitignored
     * (the desktop package's precedent). */
    "outDir": "dist-types",
    "emitDeclarationOnly": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["mods/**/*.ts"],
  "references": [
    /* demo-hooks imports "@rpgm-tools/neo-angband-core" by its published name,
     * resolved to core's build output through the workspace link. */
    { "path": "../core" },
    /* demo-sandbox and demo-trusted import the web front end's sandbox/trusted
     * runtimes by relative path into src/; referencing this package's own
     * project lets those resolve to its declaration output instead of
     * duplicating its compilation. */
    { "path": "." }
  ]
}
