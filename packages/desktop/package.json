{
  "name": "@rpgm-tools/neo-angband-desktop",
  "version": "0.15.0",
  "private": true,
  "description": "Electron front end: the same web app, handed a real filesystem and argv",
  "license": "GPL-2.0-only",
  "author": "neostryder (RPGM Tools)",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "pnpm build && electron .",
    "dev": "pnpm --filter @rpgm-tools/neo-angband-web bundle && pnpm build && electron .",
    "clean": "node scripts/clean-dist.mjs",
    "dist": "pnpm run clean && pnpm --filter @rpgm-tools/neo-angband-web bundle && pnpm build && electron-builder",
    "dist:ci": "pnpm run clean && pnpm --filter @rpgm-tools/neo-angband-web bundle && pnpm build && electron-builder --publish never",
    "dist:portable": "pnpm run clean && pnpm --filter @rpgm-tools/neo-angband-web bundle && pnpm build && electron-builder --win portable",
    "install:portable": "node scripts/install-portable.mjs"
  },
  "dependencies": {
    "@rpgm-tools/neo-angband-cli": "workspace:*",
    "@rpgm-tools/neo-angband-core": "workspace:*"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "org.neoangband.desktop",
    "productName": "Neo Angband",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/main.cjs",
      "dist/preload.cjs",
      "package.json",
      "!node_modules/**/*",
      {
        "from": "../web/dist-web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Game",
      "maintainer": "neostryder <neostryder@users.noreply.github.com>",
      "icon": "build/icon.png"
    }
  }
}
