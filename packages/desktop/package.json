{
  "name": "@neo-angband/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron front end: the same web app, handed a real filesystem and argv",
  "license": "GPL-2.0-only",
  "author": "neostryder (RPGM Tools)",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "pnpm build && electron .",
    "dev": "pnpm --filter @neo-angband/web bundle && pnpm build && electron .",
    "dist": "pnpm --filter @neo-angband/web bundle && pnpm build && electron-builder"
  },
  "dependencies": {
    "@neo-angband/cli": "workspace:*",
    "@neo-angband/core": "workspace:*"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "org.neoangband.desktop",
    "productName": "Neo Angband",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/main.cjs",
      "dist/preload.cjs",
      "../web/dist-web/**/*"
    ],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Game",
      "maintainer": "neostryder <neostryder@users.noreply.github.com>",
      "icon": "build/icon.png"
    }
  }
}
