{
  "name": "@neo-angband/linoleum",
  "version": "0.1.0",
  "private": true,
  "description": "Linoleum tile-pack tools: convert bundled legacy tilesheets into loose-pack Linoleum format",
  "author": "neostryder (RPGM Tools)",
  "license": "GPL-2.0-only",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./targets": { "types": "./dist/targets.d.ts", "default": "./dist/targets.js" },
    "./naming": { "types": "./dist/naming.d.ts", "default": "./dist/naming.js" },
    "./md5": { "types": "./dist/md5.d.ts", "default": "./dist/md5.js" }
  },
  "bin": {
    "neo-linoleum": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5"
  }
}
