#!/bin/sh
# Refuse a commit that would put private information into a PUBLIC repository:
# the maintainer's legal name, work email or employer, a private project
# codename, or an absolute path naming a machine's user account.
#
# Reads the STAGED blobs, not the working tree, so a partially-staged file is
# judged on the half that is actually going in. That is the whole point: the CI
# scan asks `git ls-files`, so a brand-new file is invisible to it until it is
# already committed - and for a public repo, "committed and pushed" is already
# too late. This hook is the only gate that sees a new file before it exists.
#
# THIS HOOK ALSO GATES THE COMPANION MOD REPOSITORIES. It finds the scanner
# relative to ITSELF, not to the repository being committed to, and passes that
# repository as --root - so a mod clone needs no copy of the hook, the scanner
# or the rules:
#
#   in this repo:   git config core.hooksPath .githooks
#   in a mod repo:  git config core.hooksPath /path/to/neo-angband/.githooks
#
# Bypass (and CI will still catch it, later): git commit --no-verify
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SCANNER="$HOOK_DIR/../tools/private-scan.mjs"

# Fail closed. A hook that cannot find its scanner and exits 0 is worse than no
# hook at all: it reports success on every commit forever, and the first time
# anyone finds out is after the leak.
if [ ! -f "$SCANNER" ]; then
  echo "pre-commit: cannot find the scanner at $SCANNER" >&2
  echo "pre-commit: core.hooksPath must point at a neo-angband checkout's .githooks" >&2
  exit 1
fi

exec node "$SCANNER" --staged --root "$(git rev-parse --show-toplevel)"
