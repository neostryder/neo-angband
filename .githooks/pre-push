#!/bin/sh
# Refuse a plain push of master to origin - IN THIS REPO ONLY.
#
# This repository's local history and its public one are different graphs -
# the public repo is a curated replay built by tools/publish.mjs, not a
# fast-forward of this branch (see docs/RELEASING.md's "git push origin
# master is NOT how this repository publishes"). A plain push of master is
# harmless by itself: git already rejects it as a non-fast-forward, since the
# two histories share no common tip. The actual risk is what happens next -
# reaching for --force out of habit, which would publish the private
# development history a curated repo exists to keep off the public one.
#
# So this hook turns "git rejects it, cryptically, after you already typed
# --force" into a same-second, friendly refusal naming the right command,
# for the one push that is never correct here. Nothing else is touched: a
# tag push, a feature branch, or master under any remote but "origin" all go
# through untouched.
#
# THE FOUR MOD REPOSITORIES SHARE THIS FILE (same mechanism as pre-commit:
# `git config core.hooksPath /path/to/neo-angband/.githooks`), and a mod repo's
# master pushes NORMALLY - RELEASING.md's own mod section is "commit, tag,
# push the tag", no publish.mjs, no replay. Found the hard way: it blocked
# neo-angband-mod-borg's real, ordinary, fast-forward push of two already-
# tagged-and-released commits, on the strength of a rule that only this one
# repository's history needs. So the gate is "does tools/publish.mjs exist
# in the repo actually being pushed", not just "is the ref master."
#
# Bypass, for the rare case this is genuinely wrong even here: git push --no-verify.

TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$TOPLEVEL" ] || [ ! -f "$TOPLEVEL/tools/publish.mjs" ]; then
  cat >/dev/null
  exit 0
fi

if [ "$1" != "origin" ]; then
  cat >/dev/null
  exit 0
fi

REFUSE=0
while read -r local_ref _local_sha remote_ref _remote_sha; do
  if [ "$local_ref" = "refs/heads/master" ] && [ "$remote_ref" = "refs/heads/master" ]; then
    REFUSE=1
  fi
done

if [ "$REFUSE" = "1" ]; then
  echo "" >&2
  echo "pre-push: refusing a plain push of master to origin." >&2
  echo "" >&2
  echo "This repo's public master is a curated replay, not this branch." >&2
  echo "Publish with:" >&2
  echo "" >&2
  echo "    node tools/publish.mjs --push" >&2
  echo "" >&2
  echo "See docs/RELEASING.md. If you genuinely mean to push this ref" >&2
  echo "directly, git push --no-verify skips this check." >&2
  echo "" >&2
  exit 1
fi

exit 0
