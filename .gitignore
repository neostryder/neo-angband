node_modules/
dist/
dist-web/
# Declarations tsc emits only so the Electron front end can join `tsc -b`; the
# runnable main process is bundled by esbuild into dist/.
dist-types/
# electron-builder installers.
dist-desktop/
coverage/
*.tsbuildinfo
.env
.env.*
*.log

# Reference C-tree build artifacts (built locally as the parity oracle)
reference/build*/

# Linoleum converter output (default CLI out dir and test output)
/build/
.test-out/
.test-out-authoring/

# Nothing in this repository writes here any more, and that is the point: mod
# resources belong to the mod. The six converted Linoleum tile packs (9161 files,
# 42 MiB) used to be generated into this directory at build time and served from
# the game's own origin; they now live in neo-angband-mod-linoleum and reach a
# player through the installer, which writes them into the mod's own folder.
#
# The ignore stays so a locally built pack can be dropped in for testing without
# any chance of being committed.
packages/web/public/mods/

# The tilesets Vite serves, COPIED from reference/lib/tiles at build time by
# packages/web/scripts/sync-tiles.mjs. Vite serves public/ and cannot reach
# outside its own package, so the tiles have to live here - but committing them
# meant 20 MB stored twice, and the two copies drifted apart (the graf-*.prf
# files went to upstream master while the PNGs stayed at 4.2.6). One copy in the
# repository, derived on every build, makes that impossible instead of merely
# detectable.
#
# Note the trailing /* rather than /: git does not descend into an excluded
# DIRECTORY, so the negation below would never be consulted.
packages/web/public/tiles/*
# ...except CREDITS.md, which is OURS and not upstream's. It carries Raymond
# Gaustadnes' grant of free use for the Shockbolt tiles - as the Angband
# tilesheet and converted to separate tiles - on the condition that this project
# does not profit from sales or other income. The condition rides along with the
# art: a commercial release needs a licence from the author.
!packages/web/public/tiles/CREDITS.md

# The bundled mods built to the plugin.js their OWN repositories ship
# (packages/web/scripts/build-mod-plugins.mjs). Derived from mods/<id>/plugin.ts and
# reproducible from it, so it is built rather than committed - the artefact belongs in
# neo-angband-mod-<id>, not here.
packages/web/build/

# Stray compiled output from plugin sources under mods/ (source is *.ts)
packages/web/mods/**/*.js
packages/web/mods/**/*.d.ts
packages/web/mods/**/*.js.map
packages/web/mods/**/*.d.ts.map

# The assistant's working rules for this repository. Not published: they are how
# WE work here, not something a reader of the port needs, and several of them
# name local paths on a particular machine. The file is NOT moved, because it
# only takes effect at the repository root - it is loaded from disk, and being
# untracked changes nothing about that.
#
# A snapshot is kept in the private working record (working-instructions/), since
# the squash in #147 removes the history that is currently its only backup.
CLAUDE.md

# Local-only parity remediation breadcrumb: points at the private planning
# workspace, so it must never be committed to this public repo. The authoritative
# public methodology lives in docs/PARITY.md; the per-module provenance map is
# parity/ledger/.
parity/PARITY_REMEDIATION_2026-07-21.md

# tools/play-smoke.mjs writes its frames here; the CI job uploads them as an
# artifact rather than committing them.
smoke-shots/

# tools/tall-tile-probe.mjs does the same. It is run by hand against two builds
# to compare them, so its output is a working artefact, not a fixture: 13 MB of
# PNGs per pair of runs.
tall-tile-shots/
