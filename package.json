{
  "name": "neo-angband",
  "version": "1.23.0-beta.3",
  "private": true,
  "description": "A faithful but moddable port of Angband, meant to be playable almost anywhere.",
  "author": "neostryder (RPGM Tools)",
  "license": "GPL-2.0-only",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:electron": "playwright test --project=electron",
    "typecheck": "tsc -b",
    "check:private": "node tools/private-scan.mjs",
    "check:npm": "node tools/check-npm-package.mjs",
    "check:version": "node tools/version.mjs",
    "mod-runner": "node packages/web/scripts/mod-runner.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@typescript/typescript6": "6.0.2",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
