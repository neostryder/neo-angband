@@ -20,6 +20,7 @@
 
 import { FEAT, MON_MSG, MON_TMD, RF, TMD } from "../generated";
 import { MDESC, MDESC_STANDARD, MDESC_TARG, monsterDesc } from "../mon/desc";
+import type { BlowMethod } from "../mon/types";
